# ── Monday.com ────────────────────────────────────────────────────────────────
# Personal API token from: https://monday.com/users/me/account/tokens
MONDAY_API_TOKEN=your_monday_api_token_here

# Numeric board IDs (find in the board URL: monday.com/boards/<ID>)
DEALS_BOARD_ID=1234567890
WORK_ORDERS_BOARD_ID=0987654321

# Set to "true" if your Monday.com account has AI Connectors / MCP enabled.
# If "false", the app falls back to direct GraphQL API (recommended default).
USE_MCP=false

# ── Google Gemini ──────────────────────────────────────────────────────────────
# API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model to use (gemini-1.5-pro recommended; gemini-1.5-flash is faster/cheaper)
GEMINI_MODEL=gemini-1.5-pro
